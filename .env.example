# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL (Docker Compose service name: postgres)
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_password
POSTGRES_DB=idempotency_db
DATABASE_URL=postgresql://app_user:app_password@postgres:5432/idempotency_db?schema=public

# Redis (Docker Compose service name: redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=idemp:
REDIS_CACHE_TTL_SECONDS=3600

# Idempotency Configuration
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_LEASE_DURATION_MS=30000
IDEMPOTENCY_MAX_KEY_LENGTH=255

# Payment Provider Simulator
PAYMENT_SIMULATOR_DELAY_MS=50

# Rate Limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
